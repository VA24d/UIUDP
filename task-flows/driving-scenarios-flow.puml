@startuml AeroDrive Driving Scenarios Task Flow
!theme plain
skinparam backgroundColor #0a0c10
skinparam defaultFontColor #F8FAFC
skinparam defaultFontName Inter
skinparam activityBackgroundColor #1A1D24
skinparam activityBorderColor #38BDF8
skinparam activityFontColor #F8FAFC
skinparam activityStartColor #10B981
skinparam activityEndColor #EF4444
skinparam activityDiamondBackgroundColor #1A1D24
skinparam activityDiamondBorderColor #FBBF24
skinparam arrowColor #38BDF8

title AeroDrive Driving Scenarios - High Level Flow

start

:Initialize Driving Environment;

partition "Select Scenario" {
    split
        :Takeover Drill
        (Construction Zone);
    split again
        :Fatigue Detection
        (Drowsiness SOS);
    split again
        :Battery Range
        (Predictive Reroute);
    split again
        :Touring Mode
        (Interactive Guide);
    split again
        :Weather Reroute
        (Traction Safety);
    end split
}

:Scenario Execution & Feedback;

:System Reset;

stop
@enduml
