@startuml AeroDrive Onboarding Task Flow
!theme plain
skinparam backgroundColor #0a0c10
skinparam defaultFontColor #F8FAFC
skinparam defaultFontName Inter
skinparam activityBackgroundColor #1A1D24
skinparam activityBorderColor #38BDF8
skinparam activityFontColor #F8FAFC
skinparam activityStartColor #10B981
skinparam activityEndColor #EF4444
skinparam activityDiamondBackgroundColor #1A1D24
skinparam activityDiamondBorderColor #FBBF24
skinparam arrowColor #38BDF8

title AeroDrive Onboarding - High Level Flow

start

:System Initialization;

partition "Onboarding Steps" {
    :Step 1: Profile Creation
    (Name, Face, Voice);
    
    :Step 2: Comfort Settings
    (Seat, Climate, Lighting);
    
    :Step 3: Location Presets
    (Home, Work);
    
    :Step 4: Learning System
    (Capabilities & Safety);
    
    :Step 5: Take-Over Simulation
    (Hands-on Practice);
    
    :Step 6: Drive Tuning
    (AI Behavior Personalization);
}

:Step 7: Setup Complete;

stop
@enduml
