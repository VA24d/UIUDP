@startuml AeroDrive Combined Task Flow
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontColor #000000
skinparam defaultFontName Inter
skinparam activityBackgroundColor #F1F5F9
skinparam activityBorderColor #334155
skinparam activityFontColor #000000
skinparam activityStartColor #10B981
skinparam activityEndColor #EF4444
skinparam activityDiamondBackgroundColor #F1F5F9
skinparam activityDiamondBorderColor #64748B
skinparam arrowColor #334155

title AeroDrive System - Complete Task Flow Summary

start

partition "Initialization" {
    :Load HTML & External Resources;
    :Initialize Core Engines (Voice, Audio, Physics);
    :Setup UI & Event Listeners;
    :Validate System Health;
}

partition "Onboarding" {
    :Step 1: Profile Creation;
    :Step 2: Comfort Settings;
    :Step 3: Location Presets;
    :Step 4: Learning System;
    :Step 5: Take-Over Simulation;
    :Step 6: Drive Tuning;
    :Step 7: Setup Complete;
}

partition "Driving Simulations" {
    :Activate Driving Environment;
    
    split
        :Takeover Drill;
    split again
        :Fatigue Detection;
    split again
        :Battery Range;
    split again
        :Touring Mode;
    split again
        :Weather Reroute;
    end split
    
    :Scenario Feedback & Logging;
    :System Reset;
}

stop
@enduml
